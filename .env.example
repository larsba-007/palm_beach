# ==============================================================================
# GOLD COAST GAMBITS - macOS BUILD & PUBLISH PIPELINE CONFIGURATION
# Copy this file to '.env' and fill in your actual credentials.
# Keep '.env' private and NEVER commit it to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Apple Developer & Notarization Credentials
# ------------------------------------------------------------------------------
# Your Apple ID email address (e.g., developer@example.com)
APPLE_ID=

# An App-Specific Password generated at https://appleid.apple.com
# Format is usually: xxxx-xxxx-xxxx-xxxx (do NOT use your main account password)
APPLE_PASSWORD=

# Your Apple Developer Team ID (10-character alphanumeric, e.g., A1B2C3D4E5)
# Found in your Apple Developer Account under Membership details.
APPLE_TEAM_ID=

# Optional: Your Mac login password. 
# Used by the publish script to unlock your keychain so that codesign can sign 
# the macOS app without displaying interactive GUI prompts on your desktop.
KEYCHAIN_PASSWORD=


# ------------------------------------------------------------------------------
# SteamCMD Configuration & Credentials
# ------------------------------------------------------------------------------
# Path to the SteamCMD executable.
# Examples:
#   - If installed via homebrew: /opt/homebrew/bin/steamcmd
#   - If installed manually: /Users/username/steamcmd/steamcmd.sh
#   - Leave empty if 'steamcmd' is in your system PATH
STEAMCMD_PATH=

# Your Steam Account username (e.g., backhans_dev)
# This account must have publishing rights to the App IDs listed below.
STEAM_USERNAME=

# Your Steam Account password.
# Leave blank to be prompted securely by SteamCMD on execution.
STEAM_PASSWORD=


# ------------------------------------------------------------------------------
# Steam App & Depot IDs - Demo Version
# ------------------------------------------------------------------------------
STEAM_APP_ID_DEMO=
STEAM_DEPOT_ID_DEMO=
STEAM_DEPOT_ID_DEMO_WIN=


# ------------------------------------------------------------------------------
# Steam App & Depot IDs - Full Version
# ------------------------------------------------------------------------------
STEAM_APP_ID_FULL=
STEAM_DEPOT_ID_FULL=
STEAM_DEPOT_ID_FULL_WIN=
